{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "description": "Generate typed React Query hooks from the GraphQL schema",
      "dependsOn": ["backend:gen-graphql-schema"],
      "options": {
        "command": "npx graphql-codegen --config codegen.ts",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "dependsOn": ["^build", "codegen"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["codegen"],
      "options": {
        "config": "{projectRoot}/vitest.config.ts",
        "reportsDirectory": "../../coverage/apps/frontend",
        "passWithNoTests": true,
        "reporter": "verbose"
      }
    }
  }
}
