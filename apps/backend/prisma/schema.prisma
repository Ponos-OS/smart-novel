// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NarrationStatus {
  PROCESSING
  READY
  FAILED
}

enum NovelState {
  ONGOING
  FINISHED
}

enum LicenseSourceType {
  CANONICAL
  FORKED
  CUSTOM
}

model License {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  text        String            @db.Text
  textHash    String            @unique @map("text_hash")
  sourceType  LicenseSourceType @map("source_type")
  canonicalId String?           @map("canonical_id")
  isDefault   Boolean           @default(false) @map("is_default")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  novels Novel[]

  @@map("licenses")
}

model Novel {
  id        String @id @default(uuid()) @db.Uuid
  ownerId   String @map("owner_id")
  licenseId String @map("license_id") @db.Uuid

  name        String
  author      String
  description String     @db.Text
  state       NovelState @default(ONGOING)
  coverUrl    String?    @map("cover_url")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  license           License            @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  chapters          Chapter[]
  categories        NovelCategory[]
  chapterUserStates ChapterUserState[]

  @@index([ownerId], name: "IDX_novels_owner")
  @@index([licenseId], name: "IDX_novels_license")
  @@map("novels")
}

model Chapter {
  id        String @id @default(uuid()) @db.Uuid
  novelId   String @map("novel_id") @db.Uuid
  contentId String @unique @map("content_id") @db.Uuid

  title           String
  narrationStatus NarrationStatus? @map("narration_status")
  narrationUrl    String?          @map("narration_url")
  chapterNumber   Int              @map("chapter_number")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  novel      Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  content    ChapterContent     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userStates ChapterUserState[]

  @@unique([id, novelId])
  @@index([novelId], name: "IDX_chapters_novel")
  @@map("chapters")
}

model ChapterContent {
  id      String @id @default(uuid()) @db.Uuid
  content String @db.Text

  // optional full-text search/materialized info
  contentTsv  Unsupported("tsvector")? @map("content_tsv")
  // change-detection for narration regen; distinct from updatedAt so a no-op save doesn't retrigger TTS
  contentHash String                   @map("content_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // back-reference
  chapter Chapter?

  @@index([contentTsv], type: Gin)
  @@index([contentHash])
  @@map("chapter_contents")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  novels NovelCategory[]

  @@map("categories")
}

model NovelCategory {
  novelId    String @map("novel_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  novel    Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([novelId, categoryId])
  @@index([novelId], name: "IDX_novel_categories_novel")
  @@index([categoryId], name: "IDX_novel_categories_category")
  @@map("novel_categories")
}

model ChapterUserState {
  userId    String @map("user_id")
  novelId   String @map("novel_id") @db.Uuid
  chapterId String @map("chapter_id") @db.Uuid

  firstReadAt DateTime @default(now()) @map("first_read_at") @db.Timestamptz

  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId, novelId], references: [id, novelId], onDelete: Cascade)

  @@id([userId, chapterId])
  @@index([novelId], name: "IDX_chapter_user_states_novel")
  @@index([userId, novelId], name: "IDX_chapter_user_states_user_novel")
  @@index([novelId, chapterId], name: "IDX_chapter_user_states_novel_chapter")
  @@map("chapter_user_states")
}

model PlatformTermsAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  termsVersion Int      @map("terms_version")
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  @@unique([userId, termsVersion])
  @@index([userId], name: "IDX_platform_terms_acceptances_user")
  @@map("platform_terms_acceptances")
}
