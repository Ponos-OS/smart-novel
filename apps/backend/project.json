{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "beatrice:fetch-schema": {
      "executor": "nx:run-commands",
      "description": "Download Beatrice's schema.graphql (pinned by BEATRICE_VERSION) if not already present",
      "cache": false,
      "options": {
        "command": "npx ts-node --files --project tsconfig.app.json fetch-beatrice-schema.ts",
        "cwd": "{projectRoot}"
      }
    },
    "beatrice:codegen": {
      "executor": "nx:run-commands",
      "description": "Regenerate Beatrice's gql.tada introspection output from schema.graphql",
      "dependsOn": ["beatrice:fetch-schema"],
      "cache": true,
      "inputs": ["{projectRoot}/src/shared/beatrice/schema.graphql"],
      "outputs": [
        "{projectRoot}/src/shared/beatrice/graphql-env.d.ts"
      ],
      "options": {
        "command": "npx gql.tada generate-output --tsconfig tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["beatrice:codegen"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/backend"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/package.json",
        "{workspaceRoot}/dist/apps/backend/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "backend:build",
        "watch": true,
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["beatrice:codegen"],
      "options": {
        "config": "{projectRoot}/vitest.config.ts",
        "reportsDirectory": "../../coverage/apps/backend",
        "passWithNoTests": true,
        "reporter": "verbose"
      }
    },
    "prisma:format": {
      "executor": "nx:run-commands",
      "description": "Format Prisma schema files",
      "options": {
        "command": "npx prisma format --schema=prisma/schema.prisma",
        "cwd": "{projectRoot}"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "description": "Generate Prisma client",
      "options": {
        "command": "npx prisma generate",
        "cwd": "{projectRoot}"
      }
    },
    "prisma:db:push": {
      "executor": "nx:run-commands",
      "description": "Pushes the database schema to the database",
      "options": {
        "command": "npx prisma db push --accept-data-loss",
        "cwd": "{projectRoot}"
      }
    },
    "prisma:seed": {
      "executor": "nx:run-commands",
      "description": "Seed the database with initial data",
      "options": {
        "command": "npx prisma db seed",
        "cwd": "{projectRoot}"
      }
    },
    "gen-graphql-schema": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma:generate", "beatrice:codegen"],
      "description": "Generate the GraphQL SDL schema file on the host",
      "options": {
        "command": "npx ts-node --files --project tsconfig.app.json gen-graphql-schema.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
