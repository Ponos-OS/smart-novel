  "packageManager": "npm@11.10.1",
  "engines": {
    "node": "v24.13.0"
  },
  "scripts": {
    "start:dev": "docker compose --profile dev up --build -d",
    "stop:dev": "docker compose --profile dev down -v",
    "prepare": "husky || true",
    "format": "prettier . -w -u && nx prisma:format backend",
    "lint": "nx run-many -t lint --fix --skip-nx-cache",
    "lint-prepush": "nx run-many -t lint",
    "lint-staged": "lint-staged",
    "cypress:open": "cypress open --project apps/frontend-e2e",
    "clean": "rm -rf apps/frontend-e2e/cypress apps/frontend/src/generated apps/backend/schema.gql dist Diffs.txt local-setup/client local-setup/logs local-setup/pats local-setup/user-ids",
    "init": "npm ci && cp --update=none .env.example .env || true"
  },
  "private": true,
