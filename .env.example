SERVICE_NAME=smart-novel
ZITADEL_CLIENT_ID_FILE=/zitadel-pat/client/smart-novel-client-id
# NOTE: ☝️ comes from clientIdFile -- local-setup/setup-zitadel/src/services/config.service.js
# Path to the file containing the auto-generated OIDC client ID (written by setup-zitadel). We read the dynamically-generated OIDC client ID from the shared volume.
# The filename follows the pattern: /zitadel-pat/client/<SERVICE_NAME>-client-id

# Backend
BACKEND_PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8080,
LOG_LEVEL=http
LOG_MODE=PLAIN_TEXT
TTS_ENDPOINT=http://tts:3000/speak
EXPLAIN_CONTEXT_CHAR_SIZE=250
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smart_novel
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0 # 👈 Head sampling — 1.0 for local dev, lower (e.g. 0.05) in production.
OTEL_BATCH_MAX_PENDING_SPANS=2048
OTEL_BATCH_SPANS_PER_EXPORT=512
OTEL_BATCH_FLUSH_INTERVAL_MS=5000
OTEL_BATCH_EXPORT_TIMEOUT_MS=30000
# 👇 We only ship traces to the OpenTelemetry Collector — there's NO metrics or logs pipeline in local-setup/otel-collector-config.yaml. Without the following two env vars, NodeSDK defaults `OTEL_METRICS_EXPORTER` (and `OTEL_LOGS_EXPORTER`) to `otlp`, which makes a `PeriodicExportingMetricReader` POST to `${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/metrics` every minute and the collector replies with 404 Not Found (no metrics pipeline configured), spamming `metrics export failed (error OTLPExporterError: Not Found)` in the backend logs. Setting them to `none` skips the metric/logger provider initialization entirely. Revisit if/when we wire metrics or OTLP logs through the OpenTelemetry Collector.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# MinIO
OBJECT_STORAGE_REGION=eu
OBJECT_STORAGE_ENDPOINT=http://s3:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=smart-novel
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000

# Frontend
FRONTEND_PORT=4200
VITE_SERVICE_URL=http://localhost:8080
VITE_OTLP_ENDPOINT=http://localhost:8080 # 👈 Same-origin: same host:port the SPA is served from, so OTLP HTTP exports avoid a CORS preflight (Traefik routes /v1/traces to the otel-collector).
VITE_SERVICE_NAME=smart-novel-frontend
VITE_SERVICE_VERSION=0.0.0
# OIDC settings for the React SPA (used by oidc-client-ts / react-oidc-context)
VITE_OIDC_AUTHORITY=http://localhost:8080
# VITE_OIDC_CLIENT_ID=  # 👈 NOTE: in prod we read this from IaC output.
VITE_OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
VITE_OIDC_SCOPE='openid profile email urn:zitadel:iam:org:project:id:zitadel:aud urn:zitadel:iam:org:projects:roles urn:zitadel:iam:user:metadata'

# Beatrice (LLM service)
BEATRICE_URL=http://beatrice:3000/graphql
BEATRICE_TIMEOUT=180s # NOTE: 👈 On CPU-only hosts inference can be slow; see https://github.com/kasir-barati/smart-novel-beatrice?tab=contributing-ov-file#how-to-start-on-local-machine
BEATRICE_DEFAULT_VOICE=default # NOTE: 👈 Must be one of the voices `TTS__QWEN__VOICES` (compose.yml) exposes — the local qwen-tts dev server (local-setup/qwen-tts/server.py) only serves "default"
BACKEND_INTERNAL_URL=http://backend:3000 # NOTE: 👈 How Beatrice reaches this backend's genUploadUrl/statusCallbackUrl callbacks; keep the port in sync with BACKEND_PORT
LLM_CACHE_TTL=12h
OLLAMA_MODEL=llama3.2:3b # NOTE: 👈 Consumed by the `ollama` service (image build arg) and forwarded to `beatrice` as LLM__MODEL. Pick your LLM model from https://ollama.com/search — for TTS normalization quality, consider using at least 3B or higher versions
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice # NOTE: 👈 Consumed by the `qwen-tts` service (image build arg) — Beatrice's TTS__QWEN__BASE_URL (compose.yml) points at this local server, matching Beatrice 3.1.0's native DashScope-shaped request contract

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_DB=smart_novel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://redis:6379
# REDIS_PASSWORD= # 👈 NOTE: Passwordless for local dev, set password for production.
REDIS_MAXMEMORY_POLICY=allkeys-lfu
REDIS_PORT=6379

# ZITADEL Configuration
ZITADEL_DOMAIN=http://localhost:8080
ZITADEL_ISSUER_URL=http://localhost:8080
# Internal Docker network URL for OIDC discovery (routed through Traefik so the Host header always matches ZITADEL_EXTERNALDOMAIN).
ZITADEL_INTERNAL_URL=http://traefik:80
# Service account PAT — optional. If set, used directly. Otherwise read from ZITADEL_PAT_FILE.
# ZITADEL_PAT=
# Path to the file containing the service account PAT (written by ZITADEL on first start).
ZITADEL_PAT_FILE=/zitadel-pat/token
ZITADEL_CALLBACK_URL=http://localhost:3000/auth/callback/zitadel
ZITADEL_POST_LOGIN_URL=http://localhost:8080
ZITADEL_POST_LOGOUT_URL=http://localhost:8080
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Admin123!

# Session Configuration
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_DURATION=3600

# Traefik
TRAEFIK_EXPOSED_PORT=8080
