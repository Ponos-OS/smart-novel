SERVICE_NAME=smart-novel
# NOTE: ZITADEL_CLIENT_ID, ZITADEL_PAT, ZITADEL_MANAGEMENT_PAT, ZITADEL_WEBHOOK_SIGNING_KEY, ZITADEL_PROJECT_ID, VITE_OIDC_CLIENT_ID and ZITADEL_WRITER_USER_ID are generated when ZITADEL is configured (infra/terraform/envs/local-zitadel). The infrastructure passes them to the containers, so do not set them here.

# Backend
BACKEND_PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8080,
LOG_LEVEL=http
LOG_MODE=PLAIN_TEXT
EXPLAIN_CONTEXT_CHAR_SIZE=250
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smart_novel
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0 # 👈 Head sampling — 1.0 for local dev, lower (e.g. 0.05) in production.
OTEL_BATCH_MAX_PENDING_SPANS=2048
OTEL_BATCH_SPANS_PER_EXPORT=512
OTEL_BATCH_FLUSH_INTERVAL_MS=5000
OTEL_BATCH_EXPORT_TIMEOUT_MS=30000
# 👇 Traces and logs go to the OpenTelemetry Collector (traces to Tempo, logs to Loki); there is no metrics pipeline in `infra/terraform/modules/observability/otel-collector-config.yaml.tftpl`. Without `OTEL_METRICS_EXPORTER=none` NodeSDK POSTs to `${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/metrics` every minute and the collector replies 404, spamming `metrics export failed (error OTLPExporterError: Not Found)` in the backend logs.
OTEL_METRICS_EXPORTER=none
# 👇 How logs reach Loki: `otlp` has the backend, Beatrice and Fithara push them to the collector (a crash can lose the last seconds); `none` stops that push and runs Grafana Alloy, which tails their stdout instead.
OTEL_LOGS_EXPORTER=otlp

# RustFS
OBJECT_STORAGE_REGION=eu
OBJECT_STORAGE_ENDPOINT=http://s3:9000
OBJECT_STORAGE_ACCESS_KEY=rustfsadmin
OBJECT_STORAGE_SECRET_KEY=rustfsadmin
OBJECT_STORAGE_BUCKET=smart-novel
OBJECT_STORAGE_PUBLIC_URL=http://s3.localhost:8080

# Frontend
FRONTEND_PORT=4200
VITE_SERVICE_URL=http://localhost:8080
VITE_OTLP_ENDPOINT=http://localhost:8080 # 👈 Same-origin: same host:port the SPA is served from, so OTLP HTTP exports avoid a CORS preflight (Traefik routes /v1/traces to the otel-collector).
VITE_SERVICE_NAME=smart-novel-frontend
VITE_SERVICE_VERSION=0.0.0
# OIDC settings for the React SPA (used by oidc-client-ts / react-oidc-context)
VITE_LICENSE_DRAFT_AUTOSAVE_SECONDS=5 # 👈 How often a license draft in progress is saved to the backend, while it has unsaved changes.
VITE_OIDC_AUTHORITY=http://localhost:8080
# VITE_OIDC_CLIENT_ID=  # 👈 NOTE: in prod we read this from IaC output.
VITE_OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
VITE_OIDC_SCOPE='openid profile email urn:zitadel:iam:org:project:id:zitadel:aud urn:zitadel:iam:org:projects:roles urn:zitadel:iam:user:metadata'

# Beatrice (LLM service)
BEATRICE_VERSION=5.1.0
BEATRICE_URL=http://beatrice:3000/graphql
BEATRICE_TIMEOUT=180s # NOTE: 👈 On CPU-only hosts inference can be slow; see https://github.com/kasir-barati/smart-novel-beatrice?tab=contributing-ov-file#how-to-start-on-local-machine
BACKEND_INTERNAL_URL=http://backend:3000 # NOTE: 👈 How Beatrice reaches this backend's genUploadUrl/statusCallbackUrl callbacks; keep the port in sync with BACKEND_PORT
LLM_CACHE_TTL=12h
RUN_LOCAL_AI_MODELS=true
BEATRICE_LLM_MODEL=llama3.2:3b  # gpt-4o-mini when RUN_LOCAL_AI_MODELS=false
BEATRICE_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice # gpt-4o-mini-tts when RUN_LOCAL_AI_MODELS=false
BEATRICE_DEFAULT_VOICE=alloy # default

# Fithara (license drafting service; reached only through the backend)
FITHARA_VERSION=2.2.0
FITHARA_LLM_PROVIDER=ollama # openai when RUN_LOCAL_AI_MODELS=false
FITHARA_LLM_BASE_URL=http://ollama:11434/v1 # https://api.openai.com/v1 when RUN_LOCAL_AI_MODELS=false
FITHARA_LLM_API_KEY=ollama # Ollama ignores it, Fithara needs it non-empty; your OpenAI key when RUN_LOCAL_AI_MODELS=false
FITHARA_LLM_TIMEOUT_MS=120000
FITHARA_LLM_MODEL=llama3.2:3b # NOTE: gpt-4.1-mini Pick a model which is intelligent enough since otherwise it will NOT be able to generate the structured output we have defined.
FITHARA_URL=http://fithara:8000
FITHARA_TIMEOUT=60s

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_DB=smart_novel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://redis:6379
# REDIS_PASSWORD= # 👈 NOTE: Passwordless for local dev, set password for production.
REDIS_MAXMEMORY_POLICY=allkeys-lfu
REDIS_PORT=6379

# ZITADEL Configuration
ZITADEL_DOMAIN=http://localhost:8080
ZITADEL_ISSUER_URL=http://localhost:8080
# Internal Docker network URL for OIDC discovery (routed through Traefik so the Host header always matches ZITADEL_EXTERNALDOMAIN).
ZITADEL_INTERNAL_URL=http://traefik:80
ZITADEL_CALLBACK_URL=http://localhost:3000/auth/callback/zitadel
ZITADEL_POST_LOGIN_URL=http://localhost:8080
ZITADEL_POST_LOGOUT_URL=http://localhost:8080
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Admin123!

# Session Configuration
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_DURATION=3600

# Traefik
TRAEFIK_EXPOSED_PORT=8080
