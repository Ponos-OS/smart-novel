output "credentials" {
  description = "Where the credentials generated by ZITADEL and the setup script live, once the setup finished. Consumers mount the claim and read these files"
  value = merge(var.credentials, {
    client_id_file = "${var.credentials.mount_path}/client/${var.app_name}-client-id"
  })

  depends_on = [kubernetes_job_v1.setup]
}
