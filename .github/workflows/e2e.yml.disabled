# Caveats:
# 1. GitHub-hosted runners are slow for this (Postgres + Zitadel + MinIO + Ollama + backend + frontend) stack on a 2-vCPU/7GB runner. We might need to switch to a self-hosted runners.
# 2. Ollama: in the CI pipeline we need to download the model on every run unless we cache it.
# 3. I am still NOT sure how can I have a Trunk-based Development flow whilst having this, I mean developer has already pushed their changes, the best it is doing it preventing it from being deployed probably! But other devs will be blocked if they start branching off of main and developing a new feature.

# Keep build pipeline separate from e2e for these reasons:
#
# - Speed of signal: build/lint/unit-tests/Sonar can finish in a few minutes. Your own note in e2e.yml.disabled says the full Postgres+Zitadel+MinIO+Ollama+backend+frontend stack is slow on GitHub-hosted runners. Bundling them would make every PR wait on the slow path even for a one-line lint fix.
# - Different failure domains: a red build/lint/unit-test run means "your code is broken." A red e2e run more often means "the environment/stack flaked" (containers, network, timing) — worth triaging differently, and conflating them in one pipeline makes it harder to tell which kind of failure you're looking at from the GitHub checks list alone.
# - Independent triggers later: you'll likely want e2e gated more selectively (e.g. skip on doc-only changes, or run only on apps/** changes as it's already scoped) versus build/lint/unit-tests which you probably want on almost everything, including the Sonar config itself.

name: E2E

on:
  pull_request:
    paths:
      - 'apps/**'
      - 'compose.yml'
      - 'compose.e2e.yml'
      - 'local-setup/**'
      - 'package.json'
      - 'package-lock.json'
      - 'nx.json'
      - 'tsconfig.base.json'
      - '.env.example'
      - '.github/workflows/e2e.yml'
  push:
    branches: [main]
    paths:
      - 'apps/**'
      - 'compose.yml'
      - 'compose.e2e.yml'
      - 'local-setup/**'
      - 'package.json'
      - 'package-lock.json'
      - 'nx.json'
      - 'tsconfig.base.json'
      - '.env.example'
      - '.github/workflows/e2e.yml'

# Cancel in-flight runs when a new commit is pushed to the same PR/branch. This saves runner minutes and matches a trunk-based workflow where only the latest commit needs to be green.
concurrency:
  group: e2e-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  backend-e2e:
    name: backend-e2e
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24.13.0
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Seed .env from .env.example
        run: cp .env.example .env

      - name: Run backend e2e tests
        run: npx nx e2e backend-e2e

      - name: Upload backend logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: backend-e2e-logs
          path: local-setup/logs
          if-no-files-found: ignore
          retention-days: 7

  frontend-e2e:
    name: frontend-e2e
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24.13.0
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Seed .env from .env.example
        run: cp .env.example .env

      - name: Run frontend e2e tests (Cypress)
        run: npx nx e2e frontend-e2e

      - name: Upload Cypress videos
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: cypress-videos
          path: apps/frontend-e2e/cypress/videos
          if-no-files-found: ignore
          retention-days: 7

      - name: Upload Cypress screenshots
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: cypress-screenshots
          path: apps/frontend-e2e/cypress/screenshots
          if-no-files-found: ignore
          retention-days: 7

      - name: Upload Cypress logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: cypress-logs
          path: apps/frontend-e2e/cypress/logs
          if-no-files-found: ignore
          retention-days: 7
